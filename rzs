# ==================== HIGH ENERGY POTENTIAL ====================
def V_potential(phi):
    """
    Potential with massive scale:
    V(Φ) = V_scale * [(λ/4)(Φ² - α²)² + Λ_RZS]
    """
    return V_scale * ((lambda_param/4.0) * (phi**2 - alpha**2)**2 + Lambda_RZS)

def dV_dphi(phi):
    """
    Potential derivative (now much larger):
    dV/dΦ = V_scale * λΦ(Φ² - α²)
    """
    return V_scale * lambda_param * phi * (phi**2 - alpha**2)

# ==================== NON-MINIMAL COUPLING FUNCTIONS ====================
def F_func(phi):
    """
    Non-minimal coupling function:
    F(Φ) = 1/2 + ξ(Φ) = 1/2 + ξ₀*(Φ/α)²
    """
    return 0.5 + xi0 * (phi/alpha)**2

def dF_dphi(phi):
    """Derivative of F(Φ) with respect to Φ"""
    return 2.0 * xi0 * phi / alpha**2

def d2F_dphi2(phi):
    """Second derivative of F(Φ)"""
    return 2.0 * xi0 / alpha**2

# ==================== OPTIMIZED EQUATIONS OF MOTION ====================
def rzs_high_energy_equations(N, y):
    """
    System optimized for high energy with V_scale = 10,000.
    Includes additional damping factor for numerical stability.
    """
    phi, X = y
    
    # Matter density
    rho_m = Omega_m0 * np.exp(-3*N) * (H0_target**2)
    
    # Potential and its derivatives
    V = V_potential(phi)
    dV = dV_dphi(phi)
    
    # Non-minimal coupling functions
    F = F_func(phi)
    dF = dF_dphi(phi)
    d2F = d2F_dphi2(phi)
    
    # ========== H CALCULATION WITH NUMERICAL STABILITY ==========
    # 3H²F = ρ_m + ½X² + V - 3H dF X
    
    A = 3.0 * F
    B = 3.0 * dF * X
    C = -(rho_m + 0.5*X**2 + V)
    
    disc = B**2 - 4.0*A*C
    
    if disc < 0:
        H = 1e-5
    else:
        H = (-B + np.sqrt(disc)) / (2.0*A)
        if H <= 0:
            H = 1e-5
    
    # ========== ADDITIONAL DAMPING FACTOR ==========
    # For high energy, add a damping factor
    # that smooths very abrupt transitions
    damping_factor = 1.0 / (1.0 + 0.1 * abs(X))
    
    # ========== FIELD EQUATION WITH DAMPING ==========
    # dX/dt = -3HX - dV + 3(2H² + Ḣ)dF + βρ_m
    # First, calculate Ḣ in a simplified way for stability
    
    # Simplified Ḣ estimate
    H_dot_approx = -1.5 * H**2 * (1 + w_phi_estimate(phi, X, V))
    
    # Additional damping for high energy
    additional_damping = -0.01 * X * damping_factor if abs(X) > 0.1 else 0.0
    
    dX_dt = (-3.0 * H * X * damping_factor -
            dV +
            3.0 * (2.0 * H**2 + H_dot_approx) * dF +
            beta_param * rho_m +
            additional_damping)
    
    # ========== VELOCITY LIMITER ==========
    # To avoid excessive velocities with such steep potential
    max_velocity = 100.0
    if abs(dX_dt) > max_velocity:
        dX_dt = np.sign(dX_dt) * max_velocity
    
    # ========== CONVERSION TO d/dN ==========
    dphi_dN = X / H if H > 1e-6 else 0.0
    dX_dN = dX_dt / H if H > 1e-6 else 0.0
    
    return [dphi_dN, dX_dN]

def w_phi_estimate(phi, X, V):
    """Simplified w_φ estimate for Ḣ calculation"""
    rho_phi = 0.5 * X**2 + V
    if rho_phi > 0:
        return (0.5 * X**2 - V) / rho_phi
    else:
        return -1.0

